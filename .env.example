# Groq API Key
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_api_key_here

# Optional: Custom API Base URL
# GROQ_API_BASE=https://api.groq.com/openai/v1

# Local test mode toggle.
# Set to 1 to run the test suite against the REAL Groq API (consumes credits, requires GROQ_API_KEY).
# Leave as 0 (or unset) to run the offline mock suite (no network, no credits).
GROQ_LIVE_TESTS=0